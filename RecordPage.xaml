<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.RecordPage"
             Title="Запись"
             BackgroundColor="#F6FAFF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                    <Border BackgroundColor="#EAF7F8"
                            Stroke="#DDEBF3"
                            StrokeThickness="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Label Text="✚"
                               TextColor="#12A7A7"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Услуга" TextColor="#657084" FontSize="13" />

                        <Picker x:Name="ServicePicker"
                                Title="Выберите услугу"
                                BackgroundColor="White"
                                TextColor="#17213A"
                                TitleColor="#9AA8B8" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Выберите дату"
                   TextColor="#17213A"
                   FontSize="18"
                   FontAttributes="Bold" />

            <CollectionView x:Name="DateCollectionView"
                            HeightRequest="78"
                            SelectionMode="None"
                            ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding StrokeColor}"
                                StrokeThickness="1"
                                Padding="10,9"
                                Margin="0,0,8,0"
                                WidthRequest="100">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Label Text="{Binding DayName}"
                                   TextColor="{Binding TextColor}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Date_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Выберите время"
                   TextColor="#17213A"
                   FontSize="18"
                   FontAttributes="Bold" />

            <CollectionView x:Name="TimeCollectionView"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding StrokeColor}"
                                StrokeThickness="1"
                                Padding="14"
                                HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Label}"
                                       TextColor="{Binding TextColor}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center" />

                                <Label Grid.Column="1"
                                       Text="✓"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding IsSelected}" />
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Time_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Entry x:Name="NameEntry"
                           Placeholder="Имя"
                           BackgroundColor="White"
                           TextColor="#222222"
                           PlaceholderColor="#9AA8B8"
                           ClearButtonVisibility="WhileEditing" />

                    <Entry x:Name="PhoneEntry"
                           Placeholder="Телефон"
                           Keyboard="Telephone"
                           BackgroundColor="White"
                           TextColor="#222222"
                           PlaceholderColor="#9AA8B8"
                           ClearButtonVisibility="WhileEditing" />

                    <Grid x:Name="SavedPetsBorder"
                          IsVisible="False"
                          ColumnDefinitions="40,*"
                          ColumnSpacing="10"
                          Padding="0,2">
                        <Border BackgroundColor="#EAF7F8"
                                StrokeThickness="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="✚"
                                   TextColor="#12A7A7"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Питомец для записи"
                                   TextColor="#657084"
                                   FontSize="13" />
                            <Picker x:Name="SavedPetPicker"
                                    Title="Выберите из профиля"
                                    BackgroundColor="White"
                                    TextColor="#17213A"
                                    TitleColor="#9AA8B8"
                                    SelectedIndexChanged="SavedPet_Changed" />
                        </VerticalStackLayout>
                    </Grid>

                    <Entry x:Name="PetNameEntry"
                           Placeholder="Кличка питомца"
                           BackgroundColor="White"
                           TextColor="#222222"
                           PlaceholderColor="#9AA8B8"
                           ClearButtonVisibility="WhileEditing" />

                    <Picker x:Name="PetTypePicker"
                            Title="Вид питомца"
                            BackgroundColor="White"
                            TextColor="#222222"
                            TitleColor="#9AA8B8">
                        <Picker.Items>
                            <x:String>Собака</x:String>
                            <x:String>Кошка</x:String>
                            <x:String>Попугай</x:String>
                            <x:String>Другое</x:String>
                        </Picker.Items>
                    </Picker>

                    <Entry x:Name="PetAgeEntry"
                           Placeholder="Возраст питомца"
                           BackgroundColor="White"
                           TextColor="#222222"
                           PlaceholderColor="#9AA8B8"
                           ClearButtonVisibility="WhileEditing" />

                    <Editor x:Name="CommentEditor"
                            Placeholder="Комментарий"
                            BackgroundColor="White"
                            TextColor="#222222"
                            PlaceholderColor="#9AA8B8"
                            HeightRequest="100" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Записаться"
                    BackgroundColor="#12A7A7"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="52"
                    Clicked="Send_Click" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


