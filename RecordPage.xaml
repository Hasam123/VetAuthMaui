<?xml version="1.0" encoding="utf-8" ?>
<!-- Форма клиента для записи на прием к ветеринару. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.RecordPage"
             Title="Запись"
             BackgroundColor="#F3FBFF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label
                Text="Записаться на прием"
                TextColor="#413F3F"
                FontSize="26"
                FontAttributes="Bold" />

            <Border BackgroundColor="White" Stroke="#D7EDF7" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Entry
                        x:Name="NameEntry"
                        Placeholder="Имя"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9A9A9A"
                        ClearButtonVisibility="WhileEditing" />

                    <Entry
                        x:Name="PhoneEntry"
                        Placeholder="Телефон"
                        Keyboard="Telephone"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9A9A9A"
                        ClearButtonVisibility="WhileEditing" />

                    <Entry
                        x:Name="PetNameEntry"
                        Placeholder="Кличка питомца"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9A9A9A"
                        ClearButtonVisibility="WhileEditing" />

                    <Picker
                        x:Name="PetTypePicker"
                        Title="Вид питомца"
                        BackgroundColor="White"
                        TextColor="#222222"
                        TitleColor="#9A9A9A">
                        <Picker.Items>
                            <x:String>Собака</x:String>
                            <x:String>Кошка</x:String>
                            <x:String>Попугай</x:String>
                            <x:String>Кролик</x:String>
                            <x:String>Другое</x:String>
                        </Picker.Items>
                    </Picker>

                    <Entry
                        x:Name="PetAgeEntry"
                        Placeholder="Возраст питомца"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9A9A9A"
                        ClearButtonVisibility="WhileEditing" />

                    <Picker
                        x:Name="ServicePicker"
                        Title="Выберите услугу"
                        BackgroundColor="White"
                        TextColor="#222222"
                        TitleColor="#9A9A9A" />

                    <Picker
                        x:Name="DatePicker"
                        Title="Выберите дату"
                        BackgroundColor="White"
                        TextColor="#222222"
                        TitleColor="#9A9A9A"
                        SelectedIndexChanged="Date_Changed" />

                    <Picker
                        x:Name="TimePicker"
                        Title="Выберите свободное время"
                        BackgroundColor="White"
                        TextColor="#222222"
                        TitleColor="#9A9A9A" />

                    <Editor
                        x:Name="CommentEditor"
                        Placeholder="Комментарий"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9A9A9A"
                        HeightRequest="120" />

                    <Button
                        Text="Отправить заявку"
                        BackgroundColor="#EA5927"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="52"
                        Clicked="Send_Click" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>







