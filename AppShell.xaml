<?xml version="1.0" encoding="UTF-8" ?>
<!-- Главная оболочка приложения. Здесь задан стартовый экран. -->
<Shell
    x:Class="VetAuthMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VetAuthMaui"
    Title="VetAuthMaui">

    <ShellContent
        Title="Старт"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"
        Shell.TabBarIsVisible="False" />

    <TabBar Route="ClientTabs">
        <ShellContent
            Title="Главная"
            ContentTemplate="{DataTemplate local:HomePage}"
            Route="HomePage"
            Shell.TabBarIsVisible="False" />

        <ShellContent
            Title="Услуги"
            ContentTemplate="{DataTemplate local:ServicePage}"
            Route="ServicePage"
            Shell.TabBarIsVisible="False" />

        <ShellContent
            Title="Запись"
            ContentTemplate="{DataTemplate local:RecordPage}"
            Route="RecordPage"
            Shell.TabBarIsVisible="False" />

        <ShellContent
            Title="Профиль"
            ContentTemplate="{DataTemplate local:ClientPage}"
            Route="ClientPage"
            Shell.TabBarIsVisible="False" />
    </TabBar>

</Shell>









