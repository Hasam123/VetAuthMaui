<?xml version="1.0" encoding="utf-8" ?>
<!-- Меню клиента с переходами в кабинет, услуги, запись и контакты. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetAuthMaui"
             x:Class="VetAuthMaui.HomePage"
             Title="Клиент"
             BackgroundColor="#F6FAFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BackgroundColor="#12A7A7" StrokeThickness="0" Padding="24,36,24,28">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,34,34" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Label Text="Меню клиента" TextColor="White" FontSize="28" FontAttributes="Bold" />
                <Label x:Name="ClientNameLabel" Text="Все нужное для записи и контроля заявок" TextColor="#EAF7F8" FontSize="15" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,28,24,30" Spacing="12">
                <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="14">
                        <Border BackgroundColor="#EAF7F8" StrokeThickness="0" WidthRequest="54" HeightRequest="54" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Label Text="◎" TextColor="#12A7A7" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Личный кабинет" TextColor="#17213A" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Проверьте статус своих заявок по телефону." TextColor="#657084" FontSize="14" />
                            <Button Text="Открыть кабинет" BackgroundColor="#12A7A7" TextColor="White" FontAttributes="Bold" CornerRadius="22" HeightRequest="46" Clicked="Profile_Click" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="14">
                        <Border BackgroundColor="#F3F6FA" StrokeThickness="0" WidthRequest="54" HeightRequest="54" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Label Text="☰" TextColor="#657084" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Услуги и цены" TextColor="#17213A" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Посмотрите направления лечения, описание и стоимость." TextColor="#657084" FontSize="14" />
                            <Button Text="Смотреть услуги" BackgroundColor="#12A7A7" TextColor="White" FontAttributes="Bold" CornerRadius="22" HeightRequest="46" Clicked="Services_Click" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="14">
                        <Border BackgroundColor="#FFF4EC" StrokeThickness="0" WidthRequest="54" HeightRequest="54" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Label Text="✚" TextColor="#FF8A5B" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Запись на прием" TextColor="#17213A" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Оставьте заявку и сразу укажите данные питомца." TextColor="#657084" FontSize="14" />
                            <Button Text="Записаться" BackgroundColor="#FF8A5B" TextColor="White" FontAttributes="Bold" CornerRadius="22" HeightRequest="46" Clicked="Appointment_Click" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18" Margin="0,4,0,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="54,*" ColumnSpacing="14">
                        <Border BackgroundColor="#EAF7F8" StrokeThickness="0" WidthRequest="54" HeightRequest="54" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Label Text="⌂" TextColor="#12A7A7" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="О клинике" TextColor="#17213A" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Ветеринарная помощь, осмотры, вакцинация и лечение питомцев." TextColor="#657084" FontSize="14" />
                            <Label Text="8:30 - 18:00" TextColor="#FF8A5B" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Бендеры, Тирасполь, Григориополь" TextColor="#657084" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Button Text="Контакты" BackgroundColor="#12A7A7" TextColor="White" FontAttributes="Bold" CornerRadius="26" HeightRequest="52" Clicked="Contacts_Click" />
                <Button Text="Выйти" BackgroundColor="Transparent" BorderColor="#FF8A5B" BorderWidth="1" TextColor="#FF8A5B" FontAttributes="Bold" CornerRadius="26" HeightRequest="52" Clicked="Logout_Click" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavigation Grid.Row="2" />
    </Grid>
</ContentPage>


