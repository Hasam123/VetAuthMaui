<?xml version="1.0" encoding="utf-8" ?>
<!-- Экран услуг: список из базы, поиск, категории и кнопки админа. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VetAuthMaui"
             x:Class="VetAuthMaui.ServicePage"
             Title="Услуги"
             BackgroundColor="#F6FAFF">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="14">
            <Button Text="Обновить"
                    BackgroundColor="#12A7A7"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="48"
                    Clicked="Refresh_Click" />

            <Button x:Name="AddServiceButton"
                    Text="Добавить услугу"
                    BackgroundColor="#FF8A5B"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="48"
                    Clicked="Add_Click" />

            <Label x:Name="StatusLabel"
                   Text="Загрузка услуг..."
                   TextColor="#657084"
                   FontSize="14" />

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Поиск услуги"
                           BackgroundColor="White"
                           TextColor="#222222"
                           PlaceholderColor="#9AA8B8"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="Search_Changed" />

                    <Picker x:Name="CategoryPicker"
                            Title="Все категории"
                            BackgroundColor="White"
                            TextColor="#222222"
                            TitleColor="#9AA8B8"
                            SelectedIndexChanged="Category_Changed" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="ServicesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#DDEBF3"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,0,12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="{Binding Title}"
                                           TextColor="#17213A"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding Category}"
                                           TextColor="#657084"
                                           FontSize="14" />

                                    <Label Text="{Binding Description}"
                                           TextColor="#657084"
                                           FontSize="14" />

                                    <Label Text="{Binding PriceText}"
                                           TextColor="#FF8A5B"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="8"
                                                     VerticalOptions="Center"
                                                     IsVisible="{Binding IsAdminMode}">

                                    <Button Text="✎"
                                            BackgroundColor="#F3F6FA"
                                            TextColor="#657084"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            Clicked="Edit_Click" />

                                    <Button Text="✕"
                                            BackgroundColor="#F3F6FA"
                                            TextColor="#657084"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            Clicked="Delete_Click" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavigation Grid.Row="1" />
    </Grid>
</ContentPage>
