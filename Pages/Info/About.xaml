<?xml version="1.0" encoding="utf-8" ?>
<!-- Разметка страницы с описанием возможностей приложения. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.About"
             Title="О приложении"
             BackgroundColor="#F6FAFF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="VetClinic" TextColor="#17213A" FontSize="21" FontAttributes="Bold" />
                    <Label Text="Приложение ветеринарной клиники для записи на приём и ведения медицинских карт питомцев." TextColor="#657084" FontSize="15" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Для клиента" TextColor="#12A7A7" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Добавление питомцев, просмотр услуг и цен, выбор ветеринара и времени приёма. Просмотр статуса записи, истории посещений и назначений." TextColor="#657084" FontSize="15" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Для ветеринара" TextColor="#FF8A5B" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Управление записями, расписанием и услугами. Заполнение медицинских карт и просмотр предыдущих посещений питомца." TextColor="#657084" FontSize="15" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Версия" TextColor="#17213A" FontSize="18" FontAttributes="Bold" />
                    <Label Text="1.0" TextColor="#657084" FontSize="15" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>










