<?xml version="1.0" encoding="utf-8" ?>
<!-- Форма обследования и лечения: все поля на одном экране. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.MedicalRecordPage"
             Title="Медкарта"
             BackgroundColor="#F6FAFF">

    <ScrollView>
        <VerticalStackLayout x:Name="MedicalForm" Padding="20" Spacing="14">
            <Label x:Name="CompletedMessageLabel" IsVisible="False" TextColor="#657084" />
            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label x:Name="PatientLabel" TextColor="#17213A" FontSize="16" FontAttributes="Bold" />
                    <Label x:Name="AppointmentLabel" TextColor="#FF8A5B" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Обследование" TextColor="#17213A" FontSize="20" FontAttributes="Bold" />

                    <Label Text="Первичный или повторный приём (обязательно)" TextColor="#657084" />
                    <Picker x:Name="PrimaryPicker" ItemDisplayBinding="{Binding DisplayText}" TextColor="#222222" SelectedIndexChanged="Primary_Changed" />
                    <Border x:Name="PreviousRecordCard" IsVisible="False" BackgroundColor="#F6FAFF" Stroke="#DDEBF3" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Прошлое посещение" FontAttributes="Bold" TextColor="#17213A" />
                            <Label x:Name="PreviousVisitLabel" TextColor="#657084" />
                            <Label x:Name="PreviousRecordLabel" TextColor="#17213A" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Обязательные сведения: причина обращения, один из диагнозов, лечение или процедуры." TextColor="#657084" FontSize="13" />
                    <Label Text="Дата начала заболевания (необязательно)" TextColor="#657084" />
                    <HorizontalStackLayout>
                        <CheckBox x:Name="HasDiseaseDate" CheckedChanged="DiseaseDate_Changed" />
                        <DatePicker x:Name="DiseaseDatePicker" Format="dd.MM.yyyy" IsEnabled="False" TextColor="#222222" />
                    </HorizontalStackLayout>
                    <Label Text="Предварительный диагноз (обязательно один из диагнозов)" TextColor="#657084" />
                    <Editor x:Name="PredDiagEditor" Placeholder="Предварительный диагноз (или заполните заключительный)" AutoSize="TextChanges" HeightRequest="90" TextColor="#222222" />
                    <Label Text="Клинические признаки и результаты исследований" TextColor="#657084" />
                    <Editor x:Name="KlinPriznEditor" Placeholder="Опишите осмотр и исследования (необязательно)" AutoSize="TextChanges" HeightRequest="120" TextColor="#222222" />
                    <Label Text="Исход заболевания" TextColor="#657084" />
                    <Entry x:Name="IshodEntry" MaxLength="100" Placeholder="Например: улучшение, выздоровление (необязательно)" TextColor="#222222" />
                    <Label Text="Жалобы / причина обращения (обязательно)" TextColor="#657084" FontSize="14" FontAttributes="Bold" />
                    <Editor x:Name="JalobaEditor"
                            Placeholder="Опишите жалобы или причину обращения (обязательно)"
                            AutoSize="TextChanges"
                            HeightRequest="90"
                            BackgroundColor="White"
                            TextColor="#222222" />

                    <Label Text="Заключительный диагноз (обязательно один из диагнозов)" TextColor="#657084" FontSize="14" FontAttributes="Bold" />
                    <Editor x:Name="DiagnozEditor"
                            Placeholder="Заключительный диагноз (или заполните предварительный)"
                            AutoSize="TextChanges"
                            HeightRequest="90"
                            BackgroundColor="White"
                            TextColor="#222222" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Лечение" TextColor="#17213A" FontSize="20" FontAttributes="Bold" />
                    <Label Text="Назначенное лечение или выполненные процедуры (обязательно хотя бы одно)" TextColor="#657084" FontSize="13" />

                    <Label Text="Назначенное лечение" TextColor="#657084" FontSize="14" FontAttributes="Bold" />
                    <Editor x:Name="NazLechEditor"
                            Placeholder="Препарат, дозировка, курс (или заполните процедуры)"
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            BackgroundColor="White"
                            TextColor="#222222" />

                    <Label Text="Выполненная процедура" TextColor="#657084" FontSize="14" FontAttributes="Bold" />
                    <Editor x:Name="ProcedureDoneEditor"
                            Placeholder="Выполненные процедуры (или заполните лечение)"
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            BackgroundColor="White"
                            TextColor="#222222" />

                    <Label Text="Заметки врача" TextColor="#657084" FontSize="14" FontAttributes="Bold" />
                    <Editor x:Name="TreatmentNotesEditor"
                            Placeholder="Дополнительные рекомендации, повторный приём (необязательно)"
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            BackgroundColor="White"
                            TextColor="#222222" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#DDEBF3" Padding="18">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Оказанные услуги" FontSize="20" FontAttributes="Bold" TextColor="#17213A" />
                    <VerticalStackLayout x:Name="ServiceSelection" Spacing="10">
                        <Picker x:Name="ServicePicker" Title="Выберите услугу" ItemDisplayBinding="{Binding DisplayText}" TextColor="#222222" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                            <Entry x:Name="QuantityEntry" Text="1" Keyboard="Numeric" Placeholder="Количество" TextColor="#222222" />
                            <Button Grid.Column="1" Text="Добавить услугу" Clicked="AddService_Click" BackgroundColor="#12A7A7" TextColor="White" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="ServiceRows" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding DisplayText}" TextColor="#17213A" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Количество" Clicked="ServiceQuantity_Click" BackgroundColor="#EAF7F8" TextColor="#17213A" />
                                        <Button Text="Убрать" Clicked="RemoveService_Click" BackgroundColor="#FFF4EC" TextColor="#8A5A44" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="ServicesTotalLabel" Text="Итого: 0 руб." TextColor="#17213A" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SaveButton" Text="Завершить приём"
                    BackgroundColor="#8A5A44"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="52"
                    Clicked="Save_Click" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>









