<?xml version="1.0" encoding="utf-8" ?>
<!-- Список заявок для администратора: просмотр, статус и удаление. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.RequestPage"
             Title="Заявки"
             BackgroundColor="#F6FAFF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Button Text="Обновить"
                    BackgroundColor="#12A7A7"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="48"
                    Clicked="Refresh_Click" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Picker
                    x:Name="DateFilterPicker"
                    Title="Дата"
                    BackgroundColor="White"
                    TextColor="#222222"
                    TitleColor="#9AA8B8"
                    SelectedIndexChanged="Filter_Changed" />

                <Picker
                    x:Name="StatusFilterPicker"
                    Grid.Column="1"
                    Title="Статус"
                    BackgroundColor="White"
                    TextColor="#222222"
                    TitleColor="#9AA8B8"
                    SelectedIndexChanged="Filter_Changed" />
            </Grid>

            <Label x:Name="StatusLabel"
                   Text="Загрузка заявок..."
                   TextColor="#657084"
                   FontSize="14" />

            <CollectionView x:Name="RequestsCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18" Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" TextColor="#17213A" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Phone}" TextColor="#12A7A7" FontSize="15" />
                                <Label Text="{Binding PetInfo}" TextColor="#17213A" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding ServiceInfo}" TextColor="#17213A" FontSize="15" />
                                <Label Text="{Binding TimeText}" TextColor="#FF8A5B" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding Comment}" TextColor="#657084" FontSize="14" />
                                <Label Text="{Binding AdminText}" TextColor="#12A7A7" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding MedText}" TextColor="#17213A" FontSize="14" />

                                <Border BackgroundColor="{Binding Color}" StrokeThickness="0" Padding="10,6" HorizontalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusText}" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                </Border>

                                <Label Text="{Binding CreatedText}" TextColor="#9AA8B8" FontSize="13" />

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Button Text="✓"
                                            BackgroundColor="#EAF7F8"
                                            TextColor="#12A7A7"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HeightRequest="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            Clicked="Status_Click" />

                                    <Button Grid.Column="1"
                                            Text="✎"
                                            BackgroundColor="#F3F6FA"
                                            TextColor="#657084"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HeightRequest="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            Clicked="Comment_Click" />

                                    <Button Grid.Column="2"
                                            Text="✚"
                                            BackgroundColor="#FFF4EC"
                                            TextColor="#FF8A5B"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HeightRequest="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            Clicked="Med_Click" />

                                    <Button Grid.Column="3"
                                            Text="✕"
                                            BackgroundColor="#FFF0F0"
                                            TextColor="#D9534F"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            HeightRequest="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            Clicked="Delete_Click" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>











