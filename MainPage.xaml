<?xml version="1.0" encoding="utf-8" ?>
<!-- Стартовый экран: вход клиента по умолчанию. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.MainPage"
             BackgroundColor="#F6FAFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,28,20,0" ColumnDefinitions="*,44">
            <VerticalStackLayout Spacing="2">
                <Label
                    Text="Ветеринарный кабинет"
                    TextColor="#17213A"
                    FontSize="32"
                    FontAttributes="Bold" />

                <Label
                    Text="Мобильный кабинет клиента"
                    TextColor="#657084"
                    FontSize="15" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="A"
                BackgroundColor="Transparent"
                BorderColor="#DDEBF3"
                BorderWidth="1"
                TextColor="#657084"
                FontAttributes="Bold"
                CornerRadius="22"
                WidthRequest="44"
                HeightRequest="44"
                Clicked="Admin_Click" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,22,24,30" Spacing="18">
                <Image
                    Source="dog_logo.png"
                    HeightRequest="220"
                    Aspect="AspectFill"
                    HorizontalOptions="Fill" />

                <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Label
                            Text="Вход клиента"
                            TextColor="#17213A"
                            FontSize="22"
                            FontAttributes="Bold" />

                        <Entry
                            x:Name="PhoneEntry"
                            Placeholder="Телефон"
                            Keyboard="Telephone"
                            BackgroundColor="White"
                            TextColor="#222222"
                            PlaceholderColor="#9AA8B8" />

                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Пароль"
                            IsPassword="True"
                            BackgroundColor="White"
                            TextColor="#222222"
                            PlaceholderColor="#9AA8B8" />

                        <Button
                            Text="Войти"
                            BackgroundColor="#12A7A7"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="26"
                            HeightRequest="54"
                            Clicked="Login_Click" />

                        <Button
                            Text="Зарегистрироваться"
                            BackgroundColor="Transparent"
                            BorderColor="#12A7A7"
                            BorderWidth="1"
                            TextColor="#12A7A7"
                            FontAttributes="Bold"
                            CornerRadius="26"
                            HeightRequest="52"
                            Clicked="Register_Click" />

                        <Button
                            Text="О приложении"
                            BackgroundColor="Transparent"
                            TextColor="#657084"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            Clicked="About_Click" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>









