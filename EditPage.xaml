<?xml version="1.0" encoding="utf-8" ?>
<!-- Форма администратора для изменения выбранной услуги. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.EditPage"
             Title="Редактировать услугу"
             BackgroundColor="#F6FAFF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label
                Text="Редактировать услугу"
                TextColor="#17213A"
                FontSize="26"
                FontAttributes="Bold" />

            <Border BackgroundColor="White" Stroke="#DDEBF3" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Entry
                        x:Name="TitleEntry"
                        Placeholder="Название услуги"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9AA8B8"
                        ClearButtonVisibility="WhileEditing" />

                    <Editor
                        x:Name="DescriptionEditor"
                        Placeholder="Описание"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9AA8B8"
                        HeightRequest="110" />

                    <Entry
                        x:Name="PriceEntry"
                        Placeholder="Цена"
                        Keyboard="Numeric"
                        BackgroundColor="White"
                        TextColor="#222222"
                        PlaceholderColor="#9AA8B8"
                        ClearButtonVisibility="WhileEditing" />

                    <Picker
                        x:Name="CategoryPicker"
                        Title="Категория"
                        BackgroundColor="White"
                        TextColor="#222222"
                        TitleColor="#9AA8B8" />

                    <Button
                        Text="Сохранить изменения"
                        BackgroundColor="#FF8A5B"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="26"
                        HeightRequest="52"
                        Clicked="Save_Click" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>








