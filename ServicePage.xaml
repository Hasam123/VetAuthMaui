<?xml version="1.0" encoding="utf-8" ?>
<!-- Экран услуг: список из базы, поиск, категории и кнопки админа. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VetAuthMaui.ServicePage"
             Title="Услуги"
             BackgroundColor="#F3FBFF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Услуги и цены"
                   TextColor="#413F3F"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Button Text="Обновить"
                    BackgroundColor="#009EDB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    HeightRequest="48"
                    Clicked="Refresh_Click" />

            <Button x:Name="AddServiceButton"
                    Text="Добавить услугу"
                    BackgroundColor="#EA5927"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    HeightRequest="48"
                    Clicked="Add_Click" />

            <Label x:Name="StatusLabel"
                   Text="Загрузка услуг..."
                   TextColor="#646464"
                   FontSize="14" />

            <Border BackgroundColor="White" Stroke="#D7EDF7" StrokeThickness="1" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Поиск услуги"
                           BackgroundColor="White"
                           TextColor="#222222"
                           PlaceholderColor="#9A9A9A"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="Search_Changed" />

                    <Picker x:Name="CategoryPicker"
                            Title="Все категории"
                            BackgroundColor="White"
                            TextColor="#222222"
                            TitleColor="#9A9A9A"
                            SelectedIndexChanged="Category_Changed" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="ServicesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#D7EDF7" StrokeThickness="1" Padding="16" Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Title}" TextColor="#413F3F" FontSize="18" FontAttributes="Bold" />
                                        <Label Text="{Binding Category}" TextColor="#646464" FontSize="14" />
                                        <Label Text="{Binding Description}" TextColor="#646464" FontSize="14" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding PriceText}"
                                           TextColor="#EA5927"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Center" />
                                </Grid>

                                <Button Text="Редактировать"
                                        BackgroundColor="#009EDB"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="20"
                                        HeightRequest="44"
                                        IsVisible="{Binding IsAdminMode}"
                                        Clicked="Edit_Click" />

                                <Button Text="Удалить"
                                        BackgroundColor="#EA5927"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="20"
                                        HeightRequest="44"
                                        IsVisible="{Binding IsAdminMode}"
                                        Clicked="Delete_Click" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>








